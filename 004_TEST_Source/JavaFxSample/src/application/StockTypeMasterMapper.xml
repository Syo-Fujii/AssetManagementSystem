<?xml version="1.0" encoding="UTF-8" ?>
<!-- <!DOCTYPE mapper SYSTEM "https://mybatis.org"> -->

<mapper namespace="application.mapper.IMySqlMapper">

    <!-- 全件取得：idはメソッド名、resultTypeは戻り値のクラス -->
    <select id="selectAll">
        SELECT M.id FROM stock_type_master M
    </select>

    <!-- 1件取得：#{id} は引数の値が入る場所 -->
    <select id="selectOnes">    
        SELECT * FROM stock_type_master WHERE id = #{id}
    </select>

    <!-- 新規登録 -->
    <insert id="newRecord"> 
        INSERT INTO stock_type_master (id) VALUES (#{id})
    </insert>

</mapper>
