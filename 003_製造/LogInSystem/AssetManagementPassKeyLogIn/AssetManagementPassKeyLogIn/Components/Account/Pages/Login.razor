@page "/"
@page "/account/login"
@using Fido2NetLib
@using QRCoder
@using System.Text.Json
@using AssetManagementPassKeyLogIn.Services
@using Microsoft.AspNetCore.Components.Authorization

@rendermode InteractiveServer


<PageTitle>QRコードログイン - 備品管理システム</PageTitle>

<div class="container d-flex justify-content-center align-items-center login-container">
    <div class="card shadow-lg p-4 text-center login-card">
        <div class="card-body">
            <h3 class="card-title mb-3 fw-bold text-primary">備品管理システム</h3>
            <p class="card-text text-muted mb-4">
                スマートフォンの標準カメラで以下のQRコードを読み取り、生体認証（指紋・顔）を行ってログインしてください。
            </p>

            <!-- 💡 作成した子コンポーネントを呼び出す。認証成功時の受け皿（HandleLoginSuccess）を指定する -->
            <PasskeyQrCode OnAuthSuccess="HandleLoginSuccess" />

            <!-- 注意書き -->
            <div class="mt-4 p-3 bg-light text-start rounded notice-box" >
                <ul class="mb-0 text-muted ps-3">
                    <li>PCとスマートフォンの <b>Bluetooth</b> を有効にしてください。</li>
                    <li>同一のWi-Fiネットワーク環境を推奨します。</li>
                </ul>
            </div>

        </div>
    </div>
</div>
