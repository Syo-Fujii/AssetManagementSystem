@page "/"
@page "/account/login"
@using Fido2NetLib
@using QRCoder
@using System.Text.Json
@using AssetManagementPassKeyLogIn.Services
@using Microsoft.AspNetCore.Components.Authorization

@rendermode InteractiveServer


<PageTitle>QRコードログイン - 備品管理システム</PageTitle>
<div class="login-screen-wrapper">
    <div class="login-card">
        <div class="card-body w-100">

            <!-- タイトル -->
            <h3 class="card-title">備品管理システム LOG-IN</h3>

            <!-- 説明文 -->
            <div class="card-content">
                <h3 class="card-text text-muted mb-3 text-start">
                    スマートフォンの標準カメラでQRコードを読み取り、サインイン(認証：生体(指紋・顔）/ Pass) を行ってログインしてください。
                </h3>
            </div>

            <!-- 注意書きボックス -->
            <div class="notice-box">
                <ul class="mb-0 text-muted ps-3">
                    <li>PCとスマートフォンの <b>Bluetooth</b> を有効にしてください。</li>
                    <li>同一のWi-Fiネットワーク環境を推奨します。</li>
                    <li>[iPhone]の場合、 <b>コントロールセンター</b> のコード読取機能を用いた読取を推奨します。</li>
                </ul>
            </div>

            <!-- QRコードコンポーネント(PasskeyQrCode呼出) -->
            <div class="mt-4 w-100 d-flex justify-content-center">
                <PasskeyQrCode OnAuthSuccess="HandleLoginSuccess" />
            </div>

            <!-- パスキー登録画面へのリンクボタン -->
            <div class="register-link-container">
                <a href="/Account/PassKeyRegister" class="btn-register-link">
                    ⚙️ 初めての方・パスキーの新規登録はこちら
                </a>
            </div>

        </div>
    </div>

</div>