@page "/Account/PassKeyRegister"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using AssetManagementPassKeyLogIn.Data
@using Fido2NetLib
@using System.Text.Json

@rendermode InteractiveServer

<PageTitle>パスキー登録 - 備品管理システム</PageTitle>

<div class="login-screen-wrapper">
    <div class="login-card">
        <div class="card-body">

            <!-- タイトル -->
            <h3 class="login-title">備品管理システム パスキー登録</h3>

            <div class="login-text-content">
                <p class="login-text">
                    パスキーを登録するには、まず社員IDとパスワードによる本人確認を行ってください。
                </p>
            </div>

            <!-- フォームエリア -->
            <div class="register-form-area">
                <div class="form-group mb-3">
                    <label class="form-label">社員ID</label>
                    <input type="text" @bind="EmployeeId" class="form-control" placeholder="例: EMP001" disabled="@IsProcessing">
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">パスワード</label>
                    <input type="password" @bind="Password" class="form-control" placeholder="••••••••" disabled="@IsProcessing">
                </div>

                <div class="login-btn-container">
                    <button class="custom-login-btn success-color" @onclick="CreateNewPasskey" disabled="@IsProcessing">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>処理中...</span>
                        }
                        else
                        {
                            <span>🔒 本人確認をしてパスキーを登録</span>
                        }
                    </button>
                </div>
            </div>

            <!-- ステータス・エラー表示領域 -->
            <div class="status-error-container">
                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="alert @(IsSuccess ? "alert-success" : "alert-danger") small">
                        @if (IsProcessing && !IsSuccess)
                        {
                            <span class="spinner-grow spinner-grow-sm me-1" role="status"></span>
                        }
                        @Message
                    </div>
                }
            </div>

            <!-- 戻るリンク -->
            <div class="back-to-login">
                <a href="/" class="btn btn-link text-decoration-none">⬅️ ログイン画面に戻る</a>
            </div>

        </div>
    </div>
</div>
