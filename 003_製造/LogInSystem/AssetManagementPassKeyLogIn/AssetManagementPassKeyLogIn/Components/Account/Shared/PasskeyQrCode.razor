@using Fido2NetLib
@using System.Text.Json
@using AssetManagementPassKeyLogIn.Services

@rendermode InteractiveServer

<!-- QRコード認証[PassKey認証]クラス -->
<div class="passkey-qr-component text-center">
    <!-- QRコード表示エリア -->
    <div class="qr-container p-3 my-3 bg-light rounded d-inline-block qr-dashed-box">
        @if (!string.IsNullOrEmpty(QrCodeImageSrc))
        {
            <img src="@QrCodeImageSrc" alt="ログイン用QRコード" class="qr-display-area" />
        }
        else
        {
            <div class="d-flex flex-column align-items-center justify-content-center qr-display-area">
                <div class="spinner-border text-primary mb-2" role="status"></div>
                <span class="text-muted small">QRコードを生成中...</span>
            </div>
        }
    </div>

    <!-- ステータス・エラー表示 -->
    <div class="mt-3">
        @if (IsProcessing)
        {
            <div class="text-success small fw-bold animate-pulse">
                <span class="spinner-grow spinner-grow-sm me-1" role="status"></span>
                スマートフォンからの接続を待機中...
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3 small" role="alert">
                @ErrorMessage
            </div>
        }
    </div>
</div>