2026-03-18 19:33:15 [Thread-6] DEBUG a.r.m.I.getTableReturnableStockData - ==>  Preparing: WITH BASE_TABLE AS ( SELECT DISTINCT SM.serial_no , SD.id FROM stock_type_master STM /* 参照権限を考慮する場合に用いる INNER JOIN stock_type_data STD ON STM.stock_type = STD.stock_type AND STM.stock_code = STD.stock_code*/ INNER JOIN stock_master SM ON STM.stock_type = SM.stock_type AND STM.stock_code = SM.stock_code AND STM.del = FALSE AND SM.del = FALSE AND SM.rent_flg = FALSE INNER JOIN stock_data SD ON SM.serial_no = SD.serial_no /* 返却済データの除去 ≒ 最新の備品データを取得 */ AND SD.return_date IS NULL AND SD.del = FALSE /* [在庫](返却)データの取得(社員番号が設定されていないデータ) */ AND SD.staff_no IS NULL /* [不明]のデータは対象としない */ AND (DATEDIFF(CURRENT_DATE(), SD.confirmed_date) <= 365 ) WHERE 1 = 1 AND STM.stock_type = ? AND STM.stock_code = ? ) SELECT STM.name AS type_name , SM.serial_no AS serialNo , '責任　三郎' AS staffName , IFNULL(DATE_FORMAT(SD.start_date, '%Y/%m/%d'), '') AS startDate , IFNULL(DATE_FORMAT(SD.limit_date, '%Y/%m/%d'), '') AS limitDate , SM.remarks AS remarks , SM.stock_type , SM.stock_code , SD.id AS stockDataId FROM BASE_TABLE B INNER JOIN stock_master SM ON B.serial_no = SM.serial_no INNER JOIN stock_type_master STM ON SM.stock_type = STM.stock_type AND SM.stock_code = STM.stock_code INNER JOIN stock_data SD ON B.id = SD.id WHERE 1 = 1 ORDER BY SM.serial_no
