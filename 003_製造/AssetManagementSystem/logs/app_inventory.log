 /* 未登録データを考慮しLEFT JOINとする 棚卸のため削除フラグを考慮しない */ LEFT JOIN staff_master STF ON SD.staff_no = STF.staff_no WHERE 1 = 1 ) SELECT S.* FROM SOURCE_RECORDS S ORDER BY S.stockTypeType , S.stockTypeCode , S.serialNo
