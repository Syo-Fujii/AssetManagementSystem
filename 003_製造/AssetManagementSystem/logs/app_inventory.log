2026-03-24 12:03:17 [Thread-4] DEBUG a.r.m.I.getTableDetailRecords - ==>  Preparing: WITH BASE_TABLE AS ( SELECT DISTINCT SM.serial_no , SD.id FROM stock_type_master STM /* 参照権限を考慮する場合に用いる INNER JOIN stock_type_data STD ON STM.stock_type = STD.stock_type AND STM.stock_code = STD.stock_code*/ INNER JOIN stock_master SM ON STM.stock_type = SM.stock_type AND STM.stock_code = SM.stock_code AND STM.del = FALSE AND SM.del = FALSE /* 未登録データを考慮しLEFT JOINとする */ LEFT JOIN stock_data SD ON SM.serial_no = SD.serial_no /* 返却済データの除去 ≒ 最新の備品データを取得 */ AND SD.return_date IS NULL AND SD.del = FALSE WHERE 1 = 1 AND STM.stock_type = ? AND STM.stock_code = ? ) SELECT STM.name AS type_name , SM.serial_no AS serialNo , IFNULL(STF.name, '') AS staffName -- 貸出先ユーザー /* DataViewとの整合性を考慮しString型とする */ , CASE WHEN SM.rent_flg THEN '4' -- 不可 / 貸出可否(TRUEの場合、貸出不可) /* 返却処理に含めるため、[貸出中]で[不明]のデータを分ける */ WHEN SD.staff_no IS NOT NULL AND DATEDIFF(CURRENT_DATE (), SD.confirmed_date) > 365 THEN '5' -- 不明 / 可否表示は不明だがデータの種別は分ける [confirmed_date]：最終所在確認日 が１年前以前(可・貸出中に関わらず不明とする) WHEN DATEDIFF(CURRENT_DATE (), SD.confirmed_date) > 365 THEN '3' -- 不明 / [confirmed_date]：最終所在確認日 が１年前以前(可・貸出中に関わらず不明とする) WHEN SD.staff_no IS NOT NULL AND (DATEDIFF(CURRENT_DATE(), SD.confirmed_date) <= 365 ) THEN '2' -- 貸出中 WHEN SD.staff_no IS NULL AND (DATEDIFF(CURRENT_DATE(), SD.confirmed_date) <= 365 ) THEN '1' -- 可 ELSE '4' -- 不可 / 備品データが未登録の場合など、異常なデータ END AS rentFlg , IFNULL(DATE_FORMAT(SD.start_date, '%Y/%m/%d'), '-') AS startDate , IFNULL(DATE_FORMAT(SD.limit_date, '%Y/%m/%d'), '-') AS limitDate , IFNULL(DATE_FORMAT(SD.confirmed_date, '%Y/%m/%d'), '-') AS confirmedDate , SM.name AS model , SM.maker AS maker , IFNULL(SD.parent_stock_code, '-') AS destinationSerialNo -- 親シリアルナンバー , GCM.value_1 AS type , IFNULL(DATE_FORMAT(SM.expiry_date, '%Y/%m/%d'), '-') AS leaseDate , SM.remarks AS remarks , SM.stock_type , SM.stock_code , SD.id AS stockDataId , SD.staff_no AS staff_no FROM BASE_TABLE B INNER JOIN stock_master SM ON B.serial_no = SM.serial_no INNER JOIN stock_type_master STM ON SM.stock_type = STM.stock_type AND SM.stock_code = STM.stock_code /* 未登録データを考慮しLEFT JOINとする */ LEFT JOIN stock_data SD ON B.id = SD.id /* 未登録データを考慮しLEFT JOINとする */ LEFT JOIN staff_master STF ON SD.staff_no = STF.staff_no /* 未登録データを考慮しLEFT JOINとする */ LEFT JOIN generic_code_master GCM ON SM.asset_type = GCM.type_key AND GCM.generic_key = 'ASSET_TYPE' WHERE 1 = 1 ORDER BY SM.serial_no
