2026-03-24 12:03:23 [Thread-5] DEBUG a.r.m.I.getTableLoanableStockData - ==>  Preparing: WITH BASE_TABLE AS ( SELECT DISTINCT SM.serial_no , SD.id FROM stock_type_master STM /* 参照権限を考慮する場合に用いる INNER JOIN stock_type_data STD ON STM.stock_type = STD.stock_type AND STM.stock_code = STD.stock_code*/ INNER JOIN stock_master SM ON STM.stock_type = SM.stock_type AND STM.stock_code = SM.stock_code AND STM.del = FALSE AND SM.del = FALSE AND SM.rent_flg = FALSE INNER JOIN stock_data SD ON SM.serial_no = SD.serial_no /* 返却済データの除去 ≒ 最新の備品データを取得 */ AND SD.return_date IS NULL AND SD.del = FALSE /* [貸出中]データの取得 */ AND SD.staff_no IS NOT NULL /* 返却処理においては[不明]を考慮しない ⇐ [不明]のデータは対象としない */ /* AND (DATEDIFF(CURRENT_DATE(), SD.confirmed_date) <= 365 ) */ WHERE 1 = 1 AND STM.stock_type = ? AND STM.stock_code = ? ) SELECT STM.name AS type_name , SM.serial_no AS serialNo , SFM.name AS staffName , IFNULL(DATE_FORMAT(SD.start_date, '%Y/%m/%d'), '') AS startDate , IFNULL(DATE_FORMAT(SD.limit_date, '%Y/%m/%d'), '') AS limitDate , SM.remarks AS remarks , SM.stock_type , SM.stock_code , SD.id AS stockDataId , SD.staff_no AS staff_no FROM BASE_TABLE B INNER JOIN stock_master SM ON B.serial_no = SM.serial_no INNER JOIN stock_type_master STM ON SM.stock_type = STM.stock_type AND SM.stock_code = STM.stock_code INNER JOIN stock_data SD ON B.id = SD.id LEFT JOIN staff_master SFM ON SD.staff_no = SFM.staff_no WHERE 1 = 1 ORDER BY SM.serial_no
