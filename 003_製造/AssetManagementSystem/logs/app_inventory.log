2026-04-06 13:31:11 [Thread-4] DEBUG a.r.m.I.getTableRecords - ==>  Preparing: WITH SUB_TOTAL AS ( SELECT ST.stock_type , ST.stock_code , SUM(CASE WHEN SD.staff_no IS NOT NULL AND (DATEDIFF(CURRENT_DATE(), SD.confirmed_date) <= 365 ) THEN 1 ELSE 0 END) AS lending_count -- 貸出備品の数 , SUM(CASE /* 在庫 = [staff_no]：貸出先ユーザーの社員番号 が未設定(NULL) 且つ [return_date]：返却日が未設定(NULL) 且つ [confirmed_date]：最終所在確認日 が１年以内 */ WHEN SD.staff_no IS NULL AND (DATEDIFF(CURRENT_DATE(), SD.confirmed_date) <= 365 ) THEN 1 ELSE 0 END) AS stock_count -- 在庫備品の数 , SUM(CASE /* 不明 = [return_date]：返却日が未設定(NULL) 且つ [confirmed_date]：最終所在確認日 が１年前以前 ※ 貸出中・在庫を問わず１年前以前のデータを不明とする */ WHEN (DATEDIFF(CURRENT_DATE(), SD.confirmed_date) > 365 ) THEN 1 ELSE 0 END) AS unknown_count -- 不明備品の数 FROM (SELECT stock_type , stock_code FROM stock_type_master WHERE 1 = 1 AND del = FALSE) ST INNER JOIN stock_master SM ON ST.stock_type = SM.stock_type AND ST.stock_code = SM.stock_code AND SM.del = FALSE /* 未登録データを考慮しLEFT JOINとする */ LEFT JOIN stock_data SD ON SM.serial_no = SD.serial_no /* 返却済データの除去 */ AND SD.return_date IS NULL AND SD.del = FALSE WHERE 1 = 1 GROUP BY ST.stock_type , ST.stock_code ) SELECT ST.stock_type AS type, ST.stock_code AS code, ST.name AS itemName, IFNULL(S.lending_count, 0) AS loanCount, IFNULL(S.stock_count, 0) AS returnCount, IFNULL(S.unknown_count, 0) AS unknownCount, IFNULL(S.lending_count + S.stock_count, 0) AS totalCount /* 追加項目：遷移先画面サイズ */ , IFNULL( GCM.value_1, '1') AS windowSize FROM stock_type_master ST INNER JOIN SUB_TOTAL S ON ST.stock_type = S.stock_type AND ST.stock_code = S.stock_code /* 追加項目 遷移先画面サイズ */ LEFT JOIN generic_code_master GCM ON CAST(ST.stock_type AS CHAR) = GCM.type_key AND ST.stock_code = GCM.code AND GCM.generic_key = 'WINDOW_SIZE' WHERE 1 = 1 ORDER BY ST.stock_type , St.stock_code
