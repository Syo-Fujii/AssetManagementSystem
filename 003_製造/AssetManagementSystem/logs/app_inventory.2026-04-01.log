o = SM.serial_no INNER JOIN stock_type_master STM ON SM.stock_type = STM.stock_type AND SM.stock_code = STM.stock_code /* 未登録データを考慮しLEFT JOINとする */ LEFT JOIN stock_data SD ON B.id = SD.id /* 未登録データを考慮しLEFT JOINとする */ LEFT JOIN staff_master STF ON SD.staff_no = STF.staff_no /* 未登録データを考慮しLEFT JOINとする */ LEFT JOIN generic_code_master GCM ON SM.asset_type = GCM.type_key AND GCM.generic_key = 'ASSET_TYPE' WHERE 1 = 1 ORDER BY SM.serial_no
