2026-04-09 20:39:38 [Thread-5] DEBUG a.r.m.P.getTableInventoryRecords - ==>  Preparing: WITH BASE_TABLE AS ( SELECT DISTINCT SM.serial_no , SD.id FROM stock_type_master STM /* 参照権限を考慮する場合に用いる INNER JOIN stock_type_data STD ON STM.stock_type = STD.stock_type AND STM.stock_code = STD.stock_code*/ INNER JOIN stock_master SM ON STM.stock_type = SM.stock_type AND STM.stock_code = SM.stock_code AND STM.del = FALSE AND SM.del = FALSE /* 棚卸のため、INNER JOINとする */ INNER JOIN stock_data SD ON SM.serial_no = SD.serial_no /* 返却済データの除去 ≒ 最新の備品データを取得 */ AND SD.return_date IS NULL AND SD.del = FALSE WHERE 1 = 1 ) , SOURCE_RECORDS AS ( SELECT SM.serial_no AS serialNo , STM.name AS type_name , IFNULL(SM.name, '') AS model , CASE WHEN SM.rent_flg THEN '4' -- 不可 / 貸出可否(TRUEの場合、貸出不可) WHEN SD.confirmed_date < DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR) THEN '3' -- 不明 / [confirmed_date]：最終所在確認日 が１年前以前(可・貸出中に関わらず不明とする) WHEN SD.staff_no IS NOT NULL AND (DATEDIFF(CURRENT_DATE(), SD.confirmed_date) <= 365 ) THEN '2' -- 貸出中 WHEN SD.staff_no IS NULL AND (DATEDIFF(CURRENT_DATE(), SD.confirmed_date) <= 365 ) THEN '1' -- 可 ELSE '4' -- 不可 / 備品データが未登録の場合など、異常なデータ END AS rentFlg , IFNULL(STF.name, '') AS staffName -- 貸出先ユーザー , IFNULL(DATE_FORMAT(SD.start_date, '%Y/%m/%d'), '-') AS startDate , IFNULL(DATE_FORMAT(SD.limit_date, '%Y/%m/%d'), '-') AS limitDate , IFNULL(DATE_FORMAT(SD.confirmed_date, '%Y/%m/%d'), '-') AS confirmedDate , SM.remarks AS remarks , ? AS inventoryDate -- 初期値の設定(画面側との整合性を保つため、保持した値を用いる) , SM.remarks AS remarksMasterValue -- 更新比較用に現在の「備考」の値を取得ー , SD.id AS stockDataId , STM.id AS stockTypeId , STM.stock_type AS stockTypeType , STM.stock_code AS stockTypeCode , SD.limit_date AS returnDate , SD.confirmed_date AS confDate , STF.staff_no AS staffNo FROM BASE_TABLE B INNER JOIN stock_master SM ON B.serial_no = SM.serial_no INNER JOIN stock_type_master STM ON SM.stock_type = STM.stock_type AND SM.stock_code = STM.stock_code /* 棚卸のため、INNER JOINとする */ INNER JOIN stock_data SD ON B.id = SD.id /* 未登録データを考慮しLEFT JOINとする 棚卸のため削除フラグを考慮しない */ LEFT JOIN staff_master STF ON SD.staff_no = STF.staff_no WHERE 1 = 1 ) SELECT S.* FROM SOURCE_RECORDS S ORDER BY S.stockTypeType , S.stockTypeCode , S.serialNo
