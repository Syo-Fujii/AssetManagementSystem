<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="application.resources.mapper.StockDataMapper">

    <!-- 備品データ存在確認(同一シリアルNo) -->
    <select id="existsStockDataSerial" resultType="boolean" parameterType="application.java.base.dbTablesModel.StockDataModel">
      SELECT 
         EXISTS 
         (
          SELECT 
             1 
          FROM
            stock_data 
          WHERE 
            1 = 1
          AND serial_no = #{serialNo} 
         ) AS IS_EXISTS
    </select>

    <!-- 新規登録(マスタメンテナンス用) -->
    <insert id="insStockDataOnes" parameterType="application.java.base.dbTablesModel.StockDataModel"> 
      INSERT INTO stock_data
      (
        serial_no,
        confirmed_date,
        del
      ) VALUES (
        #{serialNo},
        #{confirmedDate},
        <if test="delFlg != null">
          #{delFlg}
        </if>
        <if test="delFlg == null">
          FALSE
        </if>
      )
    </insert>

    <!-- 更新(マスタメンテナンス用) -->
    <update id="updStockDataOnes" parameterType="application.java.base.dbTablesModel.StockDataModel">
      UPDATE stock_data
      <set>
        serial_no = #{serialNo},
        parent_stock_code = #{parentStockCode},
        stock_code = #{stockCode},
        
        <choose>
          <when test="staffNo != null and staffNo > -1">
            staff_no = #{staffNo},
          </when>
          <when test="staffNo == -1">
            staff_no = NULL,
          </when>
          <otherwise>staff_no = NULL,</otherwise>
        </choose>

        <choose>
          <when test="startDate != null">
            start_date = #{startDate},
          </when>
          <otherwise>start_date = NULL,</otherwise>
        </choose>

        <choose>
          <when test="limitDate != null">
            limit_date = #{limitDate},
          </when>
          <otherwise>limit_date = NULL,</otherwise>
        </choose>

        <choose>
          <when test="returnDate != null">
            return_date = #{returnDate},
          </when>
          <otherwise>return_date = NULL,</otherwise>
        </choose>

        <choose>
          <when test="confirmedDate != null">
            confirmed_date = #{confirmedDate},
          </when>
          <otherwise>confirmed_date = NULL,</otherwise>
        </choose>

        <if test="delFlg != null">
          del = #{delFlg},
        </if>
        <if test="delFlg == null">
          del = FALSE,
        </if>

      </set>
      WHERE
       id = #{id}
    </update>

    <!-- 備品データの最終所在確認日更新 -->
    <update id="updConfirmedDate" parameterType="application.java.base.dbTablesModel.StockDataModel">
       UPDATE stock_data
        SET
          confirmed_date = #{confirmedDate}
       WHERE
          id = #{id}
    </update>

</mapper>
